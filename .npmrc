; npm 12 defaults allow-remote to "none" and then refuses to download the
; @tailwindcss/oxide-wasm32-wasi tarball when regenerating package-lock.json,
; because that package declares bundleDependencies. This breaks Renovate lock
; file maintenance. Remove once https://github.com/npm/cli/issues/9800 is fixed.
allow-remote=all
ignore-scripts=true
min-release-age=7
save-exact=true
